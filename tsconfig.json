
{
  "compilerOptions": {
    "target": "ES2022",
"module": "node16",
"moduleResolution": "Node16",
  "rootDir": "./articles-backend/src",
"outDir": "./articles-backend/dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["articles-backend/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
